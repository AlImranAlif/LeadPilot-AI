# SQLite works immediately. For deployment use a PostgreSQL URL (postgresql+psycopg://...)
DATABASE_URL=sqlite:///./leadpilot.db
# demo = transparent local extraction, gemini = actual LLM API extraction
EXTRACTION_PROVIDER=demo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Configure for deployments. Leave blank only for local demonstration.
API_KEY=
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
